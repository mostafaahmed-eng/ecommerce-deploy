# ===========================================================================
# Reference environment file. Copy to `.env` for local development.
# In production on EC2 this role is played by /opt/ecommerce/.env.production,
# which scripts/aws/load-ssm-env.sh renders from SSM Parameter Store and
# writes with mode 600 (never committed, never logged).
# ===========================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Published host ports ---------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=4000
PAYMENT_PORT=4200
CART_PORT=4300
PRODUCT_PORT=4500
API_PORT=4600
SEARCH_PORT=5000
# The production stack (docker-compose.prod.yml) publishes only nginx, on:
#   HTTP_PORT=8000-tcp  HTTPS_PORT=8443-tcp
# PUBLIC_BASE_URL is the origin browsers use. The API gateway and the payment
# service derive their CORS allow-list from it and FAIL CLOSED, so this value
# must match the real origin exactly (http://localhost:8080 in local dev).
PUBLIC_BASE_URL=http://localhost:8080

# --- Owner (admin) dashboard ------------------------------------------------
# Generate a hash with:
#   node -e "const c=require('crypto');const s='<password>';const x=c.randomBytes(16).toString('hex');console.log(x+':'+c.scryptSync(s,x,64).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Payments ---------------------------------------------------------------
VODAFONE_CASH_NUMBER=01XXXXXXXXX

# --- Durable state (section 8 of DEPLOYMENT_SUMMARY.md) ---------------------
# PERSISTENCE_DRIVER=local + DATA_DIR set  -> orders/sessions/notifications are
#   written as JSON under DATA_DIR and survive `docker compose down`.
# PERSISTENCE_DRIVER=memory (or DATA_DIR empty) -> fully stateless, used by the
#   automated tests so they never leave files behind.
PERSISTENCE_DRIVER=
DATA_DIR=

# --- Receipt uploads (section 9 of DEPLOYMENT_SUMMARY.md) -------------------
# "local" keeps files on disk; "s3" is kept for a future profile and requires
# RECEIPTS_BUCKET. No S3 bucket is needed for the free-tier profile.
RECEIPTS_STORAGE_DRIVER=local
RECEIPTS_LOCAL_PATH=/app/uploads/receipts
RECEIPTS_BUCKET=

# --- Contact section (section 11 of DEPLOYMENT_SUMMARY.md) ------------------
# The email is fixed in the markup (mailto:). The phone number is strictly
# optional and MUST stay unset unless you actually want it displayed.
PUBLIC_CONTACT_PHONE=

# --- Email notifications (optional; disabled by default) --------------------
EMAIL_NOTIFICATIONS_ENABLED=false
ORDER_NOTIFICATION_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Optional Telegram order alerts ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
