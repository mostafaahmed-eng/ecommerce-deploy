aws_region        = "us-east-1"
project_name      = "ecommerce-demo"
github_repository = "mostafaahmed-eng/ecommerce-deploy"
deploy_branch     = "main"

# ---------------------------------------------------------------------------
# Case 2 only: set this when the account ALREADY has a
# token.actions.githubusercontent.com OIDC provider, so Terraform references it
# instead of trying to create a duplicate. Otherwise leave it null (default)
# and let Terraform create it.
# ---------------------------------------------------------------------------
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# ---------------------------------------------------------------------------
# EC2 instance the free-tier role may run AWS-RunShellScript on. This is the
# same value as the GitHub Actions variable AWS_INSTANCE_ID. Leave unset to
# keep the free-tier role fail-closed (it will not be able to send commands).
# ---------------------------------------------------------------------------
# free_tier_instance_id = "i-0123456789abcdef0"
